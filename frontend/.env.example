# HTTP API URL used by the browser.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Backend URL reachable by the Vite process for the development WebSocket proxy.
# For a remote, non-Compose environment, replace this with the backend tunnel URL,
# for example: https://your-backend-host.example/proxy/8000
VITE_WS_PROXY_TARGET=http://127.0.0.1:8000

VITE_ALLOWED_HOSTS=http://localhost:5173,
